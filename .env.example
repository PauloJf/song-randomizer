# Copy to .env and fill in.

# Spotify app (developer.spotify.com/dashboard). No client secret — PKCE.
SPOTIFY_CLIENT_ID=

# The playlist to roulette from.
PLAYLIST_ID=

# Comma-separated player names (exactly 4 per the current design).
PLAYERS=Player1,Player2,Player3,Player4

# Public base URL for redirect URIs. In prod: https://your-domain.
# In local dev with Docker: http://127.0.0.1:3000
BASE_URL=http://127.0.0.1:3000

# Port the backend listens on (also the port docker-compose exposes).
PORT=3000

# Secret for signing the short-lived PKCE cookie. Any random 32+ char string.
COOKIE_SECRET=change-me-to-a-long-random-string
